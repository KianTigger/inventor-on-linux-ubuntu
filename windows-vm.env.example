# Windows 11 staging VM for Autodesk Inventor 2026
# Copy to windows-vm.env and edit for your host.
# windows-vm.env is gitignored.

# Libvirt domain name.
VM_NAME="inventor-win11"

# Autodesk recommends 32 GB RAM for Inventor 2026; 16 GB is the documented
# minimum for smaller assemblies. The staging VM does not need to be left
# running while Inventor is used through Wine.
VM_MEMORY_MIB="32768"
VM_VCPUS="8"

# Windows 11 + installer cache + Inventor. 160 GiB is a practical staging
# default; increase this if you intend to retain other Autodesk products.
VM_DISK_GIB="160"
VM_DISK="/var/lib/libvirt/images/${VM_NAME}.qcow2"

# Download the official Windows 11 x64 ISO yourself, then point this at it.
# create-windows-vm.sh copies it to libvirt's boot directory so QEMU does not
# need permission to traverse your home directory.
WINDOWS_ISO_SOURCE="$HOME/Downloads/Win11_English_x64.iso"
VM_WINDOWS_ISO="/var/lib/libvirt/boot/${VM_NAME}-windows.iso"

# VNC is bound to 127.0.0.1 on the server. Access it through an SSH tunnel;
# do not open this port in the server firewall.
VM_VNC_PORT="5905"

# The offline Windows filesystem is mounted here for export-registry.sh and
# rebuild-prefix.sh. Keep this equal to WINDOWS_MOUNT in inventor.env.
VM_MOUNT="/mnt/windows"

# Ubuntu 22.04 OVMF images with Microsoft Secure Boot keys enrolled.
VM_UEFI_CODE="/usr/share/OVMF/OVMF_CODE_4M.ms.fd"
VM_UEFI_VARS="/usr/share/OVMF/OVMF_VARS_4M.ms.fd"
