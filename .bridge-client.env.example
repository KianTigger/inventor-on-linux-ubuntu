# Ubuntu client configuration for the Inventor VM Bridge.
# Copy to .bridge-client.env if the supplied hidden file is missing.
VM_NAME="inventor-win11"

# REQUIRED/RECOMMENDED: set this to the Windows VM IPv4 address.
# Find it with either:
#   virsh --connect qemu:///system domifaddr inventor-win11 --source lease
# or, inside Windows:
#   ipconfig
VM_IP="192.168.122.123"

INVENTOR_BRIDGE_PORT="8765"
INVENTOR_BRIDGE_TOKEN="CHANGE_ME_TO_THE_VALUE_FROM_C:\\InventorVmBridge\\.env"
