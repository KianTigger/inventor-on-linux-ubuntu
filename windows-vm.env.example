# Windows 11 VM used to run Autodesk Inventor 2026 and the Inventor bridge.
# Copy this file to windows-vm.env and edit values for your Ubuntu host.

# libvirt connection. qemu:///system is recommended for a server VM.
LIBVIRT_URI="qemu:///system"

# libvirt domain name.
VM_NAME="inventor-win11"

# Inventor 2026 recommends 32 GB RAM. Use 64 GB for large assemblies if the host permits it.
VM_MEMORY_MIB="32768"
VM_VCPUS="8"

# Windows + Inventor + Autodesk components + working space.
VM_DISK_GIB="200"
VM_DISK="/var/lib/libvirt/images/${VM_NAME}.qcow2"

# Download an official Windows 11 x64 ISO yourself and set this path.
WINDOWS_ISO_SOURCE="$HOME/Downloads/Win11_English_x64.iso"
# The creation script copies the ISO here so system libvirt can read it reliably.
VM_WINDOWS_ISO="/var/lib/libvirt/boot/${VM_NAME}-windows.iso"

# libvirt default NAT network is sufficient when Rishika runs on this Ubuntu host.
VM_NETWORK="default"

# VNC listens only on the Ubuntu loopback interface. Access it through SSH tunnelling.
VM_VNC_PORT="5905"

# Optional fixed guest IPv4. Leave blank to auto-discover from libvirt DHCP/ARP data.
VM_IP=""

# TCP port used by the Windows Inventor bridge.
INVENTOR_BRIDGE_PORT="8765"

# Optional explicit OVMF paths. Leave blank to let create-windows-vm.sh auto-detect them.
VM_UEFI_CODE=""
VM_UEFI_VARS_TEMPLATE=""
