# Autodesk Inventor 2026 on Ubuntu configuration
# Copy this file to inventor.env and edit only the values you need.
# inventor.env is gitignored.

# Windows installation containing a working Inventor 2026 installation.
# If this Linux server has no Windows partition, see docs/windows-vm.md; the
# included VM mount helper exposes the powered-off Windows VM here.
WINDOWS_MOUNT="/mnt/windows"

# Optional: Windows user profile to copy per-user Autodesk settings from.
# Leave empty to auto-detect the first non-system profile.
WINDOWS_USER=""

# Wine prefix used by all scripts.
WINEPREFIX="$HOME/.wine-inventor2026"

# Tested component versions. The scripts intentionally pin these.
WINE_VERSION="11.4"
DXVK_VERSION="2.7.1"
ADSK_IDENTITY_VERSION="auto"
ADSK_LICENSING_VERSION="auto"
ADSK_COMPONENTS_VERSION="auto"

# Optional Linux data directory exposed to Wine as D:.
# Example: DATA_DRIVE="/mnt/Storage"
DATA_DRIVE=""

# Optional DXVK GPU pin. Use a Vulkan UUID with no dashes (32 hex characters).
# Find UUIDs with: bash scripts/list-gpus.sh
# Example for a multi-GPU host:
# DXVK_FILTER_DEVICE_UUID="0123456789abcdef0123456789abcdef"
DXVK_FILTER_DEVICE_UUID=""

# Optional graphical session overrides for SSH/server launches.
# Leave empty to use the current environment or auto-detect a GNOME session
# owned by the same Linux user.
INVENTOR_DISPLAY=""
INVENTOR_XAUTHORITY=""
INVENTOR_DBUS_SESSION_BUS_ADDRESS=""
INVENTOR_XDG_RUNTIME_DIR=""

# Advanced overrides. Normally leave these unchanged.
DXVK_DIR="$HOME/.local/share/dxvk/dxvk-$DXVK_VERSION"
WEBVIEW2_INSTALLER="$HOME/.cache/inventor-on-linux/MicrosoftEdgeWebView2RuntimeInstallerX64.exe"
